IO_LOC "clk_27m" 45;
IO_PORT "clk_27m" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "reset_n" 14;
IO_PORT "reset_n" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// P7 pin 6/7, package 39/40: Bank 1 true-LVDS input pair.
IO_LOC "video_p" 39,40;
IO_PORT "video_p" IO_TYPE=LVDS25 PULL_MODE=NONE;

// P6 pin 13, package 16: Bank 3 at 1.8 V.
IO_LOC "adc_feedback" 16;
IO_PORT "adc_feedback" IO_TYPE=LVCMOS18 PULL_MODE=NONE DRIVE=8;

IO_LOC "led" 10;
IO_PORT "led" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// Onboard HDMI connector differential pairs.
IO_LOC "tmds_d_p[0]" 30,29;
IO_PORT "tmds_d_p[0]" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[1]" 32,31;
IO_PORT "tmds_d_p[1]" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_d_p[2]" 35,34;
IO_PORT "tmds_d_p[2]" PULL_MODE=NONE DRIVE=8;
IO_LOC "tmds_clk_p" 28,27;
IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=8;
